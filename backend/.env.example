NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://chronicle:chronicle_dev_password@localhost:5432/chronicle

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-minimum-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-minimum-32-characters-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Storage (local or s3)
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads
CDN_BASE_URL=http://localhost:3000/uploads

# S3 (if STORAGE_TYPE=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# File limits
MAX_VIDEO_SIZE_MB=500
MAX_PROFILE_IMAGE_SIZE_MB=10

# Firebase (push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Security
BCRYPT_ROUNDS=12
TOTP_SECRET_LENGTH=20

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=5

# CORS
CORS_ORIGIN=http://localhost:8081
